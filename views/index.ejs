<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Express App</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
         /* Welcome Animation */
         .welcome-screen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #ff758c;
            color: white;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            font-family: Arial, sans-serif;
            font-size: 24px;
            font-weight: bold;
            z-index: 9999;
            animation: fadeOut 3s ease-in-out forwards;
        }
        @keyframes fadeOut {
            0% { opacity: 1; }
            80% { opacity: 1; }
            100% { opacity: 0; visibility: hidden; }
        }
        .welcome-text {
            font-size: 50px;
            opacity: 0;
            animation: fadeIn 1.5s ease-in-out forwards;
        }
        .app-name {
            font-size: 40px;
            opacity: 0;
            animation: fadeIn 2s ease-in-out forwards;
        }
        .author {
            font-size: 18px;
            margin-top: 20px;
            opacity: 0;
            animation: fadeIn 2.5s ease-in-out forwards;
        }
        @keyframes fadeIn {
            0% { opacity: 0; transform: translateY(20px); }
            100% { opacity: 1; transform: translateY(0); }
        }
        body {
            scroll-behavior: smooth;
        }
        .navbar {
            background: linear-gradient(90deg, #ff7eb3, #ff758c, #ff7eb3);
        }
        .navbar-brand, .nav-link {
            color: white !important;
            font-weight: bold;
        }
        .section {
            padding: 80px 20px;
            text-align: center;
        }
        #home {
            background: linear-gradient(120deg, #84fab0, #8fd3f4);
            color: white;
        }
        #about {
            background: #f8c291;
            color: #2d3436;
        }
        #description {
            background: #82ccdd;
            color: #222f3e;
        }
        #terms {
            background: #f7d794;
            color: #222f3e;
        }
        .upload-box {
            max-width: 500px;
            margin: 0 auto;
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
        /* Floating Plus Button */
        .floating-btn {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: #ff758c;
            color: white;
            border: none;
            width: 60px;
            height: 60px;
            font-size: 28px;
            border-radius: 50%;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            cursor: pointer;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            cursor: pointer;
            transition: 0.3s;
        }
        .floating-btn:hover {
            background: #ff4d6d;
        }
        .file-input {
            display: none;
        }
        .floating-icons {
    position: fixed;
    bottom: 90px;
    right: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
}
.media-icon {
    width: 50px;
    height: 50px;
    cursor: pointer;
    transition: 0.3s;
    border-radius: 50%;
    box-shadow: 0 4px 8px rgb(1, 238, 17);
}
.media-icon:hover {
    transform: scale(1.1);
}
.floating-btn {
    position: fixed;
    bottom: 20px;
    right: 20px;
    background: #ff758c;
    color: white;
    border: none;
    width: 60px;
    height: 60px;
    font-size: 28px;
    border-radius: 50%;
    box-shadow: 0 4px 8px rgb(5, 230, 117);
    cursor: pointer;
    transition: 0.3s;
}
.floating-btn:hover {
    background: #ff4d6d;
}

    </style>
</head>
<body>
     <!-- Welcome Animation -->
     <div class="welcome-screen">
        <div class="welcome-text">Welcome</div>
        <div class="app-name">SHARING_APP</div>
        <div class="author">NAME: <strong>Sanket Patil</strong></div>
        <div class="author">Dept: <strong>CSE  (BDA1)</strong></div>

    </div>

    

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="#">SHARING_APP</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="#home">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="#about">About</a></li>
                    <li class="nav-item"><a class="nav-link" href="#description">Description</a></li>
                    <li class="nav-item"><a class="nav-link" href="#terms">PERSONAL DETAILS</a></li>
                    <li class="nav-item"><a class="nav-link" href="/gallery" class="btn btn-warning">Gallery 📷</a></li> <!-- Updated Gallery Link -->
                </ul>
            </div>
        </div>
    </nav>

    <!-- Home Section -->
    <section id="home" class="section">
        <div class="container">
            <h1>Welcome to MyApp</h1>
            <p>Upload files and manage them easily.</p>
            <div class="upload-box">
                <h3>Upload a File</h3>
                <form action="/upload" method="POST" enctype="multipart/form-data">
                    <div class="mb-3">
                        <input class="form-control" type="file" name="file" required>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Upload</button>
                </form>

                <% if (uploadedFile) { %>
                    <div class="alert alert-success mt-3 text-center">
                        <p>File uploaded successfully!</p>
                        <a href="/<%= uploadedFile %>" target="_blank" class="btn btn-outline-secondary">View File</a>
                    </div>
                <% } %>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="section">
        <div class="container">
            <h2>About Us</h2>
            <p>Our app provides a seamless way to upload and access your files.</p>
            <p>Upload with Ease: Simplify the process of storing and organizing your media.</p>

        <p>Access Anywhere, Anytime: Your memories, always at your fingertips.</p>
                
    <p> Share Effortlessly: Keep friends and family connected by sharing your favorite moments</p>
        </div>
    </section>

    <!-- Description Section -->
    <section id="description" class="section">
        <div class="container">
            <h2>Description</h2>
            <p>This system is designed for secure and efficient file management.</p>
            <p>Users can upload files and access them from anywhere.</p>
            <p> Sharing_App is crafted to ensure a safe, simple, and efficient file management experience. Whether you're uploading, organizing, or accessing your photos and videos, our app guarantees seamless navigation and secure storage for all your precious moments. Built with your memories in mind, Sharing_App is your ultimate companion for hassle-free media sharing and preservation.</p>
        </div>
    </section>

    <!-- PERSONAL DETAILS Section -->
    <section id="terms" class="section">
        <div class="container">
            <h2>PERSONAL DETAILS</h2>
            <p>By using this app, you agree to comply with our policies and guidelines.</p>
            <P>NAME :- SANKET NITINKUMAR PATIL</P>
            <P>PIET-CSE(6BDA1)</P>
            <P>ROLL NO 64</P>
        </div>
    </section>

        <!-- Videos & Images Section -->
        <section id="media" class="section" style="background: #ff9ff3; color: white;">
            <div class="container">
                <h2>Media Library</h2>
                <p>Explore uploaded videos and images.</p>
                
                <div class="row">
                    <!-- Video Icon -->
                    <div class="col-md-6 text-center">
                        <img src="https://cdn-icons-png.flaticon.com/512/189/189671.png" alt="Video Icon" width="100">
                        <h4>Videos</h4>
                    </div>
    
                    <!-- Image Icon -->
                    <div class="col-md-6 text-center">
                        <img src="https://cdn-icons-png.flaticon.com/512/1829/1829586.png" alt="Image Icon" width="100">
                        <h4>Images</h4>
                    </div>
                </div>
            </div>
        </section>
        
    
        


    <!-- Upload Success Message -->
    <div id="upload-success" class="upload-success">
        ✅ Your file is uploaded!
    </div>
    <!-- Floating Plus Button -->
    <button class="floating-btn" onclick="document.getElementById('file-upload').click()">+</button>

    <!-- Hidden File Input -->
    <form id="upload-form" action="/upload" method="POST" enctype="multipart/form-data" style="display: none;">
        <input type="file" name="file" id="file-upload" class="file-input" onchange="document.getElementById('upload-form').submit()">
    </form>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
